# calle configuration (export in your shell or daemon environment)

# CALL-E credentials — empty = DRY-RUN mode (no real calls, no balance used)
CALLE_API_KEY=
# Optional API base override (default https://api.heycall-e.com)
CALLE_API_BASE=

# Where CALL-E can reach us (public tunnel URL, e.g. https://xyz.trycloudflare.com)
CALLE_PUBLIC_URL=

# HTTP listen address (default :8080)
CALLE_ADDR=:8080

# Security — REQUIRED on a public tunnel
CALLE_INTAKE_TOKEN=          # bearer token for POST /api/events (+/batch)
CALLE_WEBHOOK_SECRET=        # X-Calle-Secret header for POST /calle/webhook

# Persistence (append-only JSONL journal of session snapshots)
CALLE_JOURNAL=data/sessions.jsonl

# Calling behavior
CALLE_ENFORCE_WINDOWS=true   # defer calls outside 9:00-20:00 recipient-local, weekdays
CALLE_RETRY_DELAY=2h         # redial delay after no_answer
CALLE_RETRY_TICK=15s         # scheduler poll interval
