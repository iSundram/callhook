# callhook configuration (export in your shell or daemon environment)

# CALL-E credentials — empty = DRY-RUN mode (no real calls, no balance used)
CALLHOOK_API_KEY=
# Optional API base override (default https://api.heycall-e.com)
CALLHOOK_API_BASE=

# Where CALL-E can reach us (public tunnel URL, e.g. https://xyz.trycloudflare.com)
CALLHOOK_PUBLIC_URL=

# HTTP listen address (default :8080)
CALLHOOK_ADDR=:8080

# Security — REQUIRED on a public tunnel
CALLHOOK_INTAKE_TOKEN=          # bearer token for POST /api/events (+/batch)
CALLHOOK_WEBHOOK_SECRET=        # X-Callhook-Secret header for POST /callhook/webhook

# Persistence (append-only JSONL journal of session snapshots)
CALLHOOK_JOURNAL=data/sessions.jsonl

# Calling behavior
CALLHOOK_ENFORCE_WINDOWS=true   # defer calls outside 9:00-20:00 recipient-local, weekdays
CALLHOOK_RETRY_DELAY=2h         # redial delay after no_answer
CALLHOOK_RETRY_TICK=15s         # scheduler poll interval

# Campaigns
CALLHOOK_MAX_CONCURRENT=3       # max in-flight calls per wave (CALL-E rejects bursts)
CALLHOOK_CAMPAIGN_JOURNAL=data/campaigns.jsonl  # campaign persistence

# ---- Platform integration adapters (POST /integrations/{platform}/webhook) ----
# Unset = that adapter answers 401 on every delivery (loud by design).
# Full setup guides: integrations/<platform>/README.md · master table: INTEGRATIONS.md

# Stripe — dashboard webhook → /integrations/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Slack — /call slash command → /integrations/slack/slash
SLACK_SIGNING_SECRET=

# Shopify — admin webhook → /integrations/shopify/webhook
SHOPIFY_API_SECRET=

# HubSpot — private-app webhooks → /integrations/hubspot/webhook
HUBSPOT_CLIENT_SECRET=
HUBSPOT_EXTERNAL_BASE_URL=     # set behind a tunnel so the signed URI matches

# PagerDuty — webhook v3 → /integrations/pagerduty/webhook
PAGERDUTY_WEBHOOK_SECRET=

# GitHub — repo webhook → /integrations/github/webhook
GITHUB_WEBHOOK_SECRET=

# Calendly — webhook subscription → /integrations/calendly/webhook
CALENDLY_WEBHOOK_SECRET=

# Typeform — form webhook → /integrations/typeform/webhook
TYPEFORM_WEBHOOK_SECRET=

# WooCommerce — store webhook → /integrations/woocommerce/webhook
WOOCOMMERCE_WEBHOOK_SECRET=

# Xero — app webhook → /integrations/xero/webhook
XERO_WEBHOOK_KEY=

# QuickBooks Online — app webhook → /integrations/quickbooks/webhook
QUICKBOOKS_VERIFIER_TOKEN=

# Paddle Billing — notification destination → /integrations/paddle/webhook
PADDLE_WEBHOOK_SECRET=

# Grafana — alerting contact point → /integrations/grafana/webhook (optional signing)
GRAFANA_WEBHOOK_SECRET=

# Datadog — webhook integration → /integrations/datadog/webhook
DATADOG_SHARED_SECRET=         # custom header value (or basic auth below)
DATADOG_WEBHOOK_USER=
DATADOG_WEBHOOK_PASSWORD=

# Intercom — app webhooks → /integrations/intercom/webhook
INTERCOM_CLIENT_SECRET=

# Chargebee — webhook basic auth → /integrations/chargebee/webhook
CHARGEBEE_WEBHOOK_USER=
CHARGEBEE_WEBHOOK_PASSWORD=

# Pipedrive — webhook basic auth (or URL token) → /integrations/pipedrive/webhook
PIPEDRIVE_WEBHOOK_USER=
PIPEDRIVE_WEBHOOK_PASSWORD=
PIPEDRIVE_URL_TOKEN=

# Generic HTTP — any platform: callhook event JSON passthrough
GENERIC_BEARER_TOKEN=          # Authorization: Bearer ...
GENERIC_WEBHOOK_SECRET=        # or X-Callhook-Secret header

# AWS SNS — topic subscription → /integrations/sns/webhook
SNS_AUTO_SUBSCRIBE=false       # true = auto-visit (signature-verified) SubscribeURL
